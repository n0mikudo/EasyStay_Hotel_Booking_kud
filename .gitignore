# Dependencies
node_modules/
*/node_modules/

# Build artifacts
build/
dist/
.cache/
.parcel-cache/
.next/
.nuxt/
coverage/

# Environment variables (never commit real env files)
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.sample
!**/.env.example
!**/.env.sample

# IDE and editor temp
.vscode/
.idea/
*.swp
*.swo

# OS junk
.DS_Store
Thumbs.db

# Logs and runtime files
*.log
logs/
logs/**
server/logs/
server/logs/**
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pids
*.pid
*.pid.lock
*.seed

# Temporary files
tmp/
temp/
*.tmp

# Local database/cache data
server/data/*.json
server/data/backups/

# Knowledge base output
kb_output/

# Unnecessary heavy docs/assets
*.pdf
*.docx
*.png

# Markdown policy: ignore by default, keep core docs only
*.md
!README.md
!项目手册.md
!部署指南.md
