# 百度地图 AK（可选，用于定位功能）
# 在 https://lbsyun.baidu.com/ 申请
# 不配置时使用免费备用 API，国内可能不稳定
BAIDU_MAP_AK=

# Coze AI 助手配置（必填，否则 /api/chat 返回 503）
# 在 https://www.coze.cn/open/api → 个人访问令牌 → 创建新令牌
COZE_API_TOKEN=pat_xxxxxxxxxxxxxxxx
# 深度模式 Bot（绑定 Workflow），从 Bot 详情页 URL 中获取 ID
COZE_BOT_ID=74xxxxxxxxxxxxxxxx
# 极速模式 Bot（原生模式，不绑定 Workflow），详见搭建指南第十二章
# 不配置时自动回退到 COZE_BOT_ID
COZE_BOT_ID_FAST=74xxxxxxxxxxxxxxxx
