{
  "name": "easystay-server",
  "version": "1.0.0",
  "description": "易宿酒店预订平台后端服务",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "seed": "node scripts/seed-database.js",
    "seed:replace": "node scripts/seed-database.js --replace-seed",
    "seed:dedupe": "node scripts/seed-database.js --dedupe-only",
    "seed:large": "node scripts/seed-database.js --merchants=120 --hotels=600",
    "seed:simple": "node scripts/seed-database.js --simple-usernames",
    "export:merchants": "node scripts/export-merchant-credentials.js"
  },
  "keywords": [
    "hotel",
    "booking",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
